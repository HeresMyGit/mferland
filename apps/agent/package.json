{
  "name": "@mferland/agent",
  "version": "0.1.0",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "playtest:local": "MFERLAND_AGENT_LOCAL_ONLY=1 tsx src/index.ts --mode playtest",
    "playthrough:local": "MFERLAND_AGENT_LOCAL_ONLY=1 tsx src/index.ts --mode playtest --playtest-scope all",
    "llm:local": "MFERLAND_AGENT_LOCAL_ONLY=1 tsx src/index.ts --mode llm",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mferland/shared": "file:../../packages/shared",
    "colyseus.js": "^0.16.22",
    "viem": "^2.40.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
