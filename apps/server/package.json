{
  "name": "@mferland/server",
  "version": "0.1.0",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development MFERLAND_ENABLE_DEBUG_MESSAGES=1 MFERLAND_LOCAL_DEBUG_AUTH_BYPASS=1 MFERLAND_DEBUG_TRASH_VENDOR_STOCK=1 tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.mjs",
    "daily:generate": "tsx --env-file-if-exists=../../.env scripts/generate-mfergpt-daily-quest.ts",
    "fishing:analytics:report": "node --env-file-if-exists=../../.env scripts/fishing-analytics-report.mjs",
    "market:refresh": "tsx --env-file-if-exists=../../.env scripts/refresh-market-quotes.ts",
    "support:admin": "node --env-file-if-exists=../../.env scripts/support-admin.mjs",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.68",
    "@mferland/shared": "file:../../packages/shared",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "viem": "^2.40.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
